programa 
{ 
    funcao inicio() 
    { 
        inteiro numero 
  
        escreva("Digite um número: ") 
        leia(numero) 
  
        se (numero % 2 == 0) 
        { 
            escreva(numero, " é par") 
        } 
        senao 
        { 
            escreva(numero, " é ímpar") 
        } 
    } 
} 
 

/*Trabalha com estrutura condicional (se/senao) e o operador resto da divisão (%). Avalia se um número digitado é par ou ímpar ao verificar o resto de sua divisão por 2.   